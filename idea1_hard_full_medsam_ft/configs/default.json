{
  "method": {
    "method_id": "idea1_hard_full_medsam_ft",
    "parent_method": "frozen_baseline_v1"
  },
  "selection": {
    "seed": 2026,
    "difficulty_iou_threshold": 0.5,
    "two_d": {
      "round0_random_images": 5,
      "add_per_round": 5,
      "max_full_images": 20
    },
    "three_d": {
      "round0_random_cases": 1,
      "add_per_round": 1,
      "max_full_cases_absolute": 5,
      "max_full_cases_ratio": 0.05,
      "ratio_rounding": "ceil",
      "worst_slice_fraction": 0.2
    }
  },
  "medsam_finetune": {
    "trainable": "mask_decoder",
    "optimizer": "adamw",
    "lr": 1e-05,
    "weight_decay": 0.01,
    "effective_batch_size": 2,
    "physical_microbatch": 1,
    "amp": true,
    "grad_clip_norm": 1.0,
    "dice_weight": 1.0,
    "bce_weight": 1.0,
    "scheduler": "none",
    "augmentation": "none",
    "steps_2d_per_round": 300,
    "steps_3d_per_round": 1000,
    "resume_previous_round": true
  },
  "pseudo": {
    "contract": "student_v2_probability_arbitration",
    "foreground_support": "selected_refined_medsam_best_mask",
    "probability_source": "same_selected_multimask_candidate",
    "probability_threshold_semantics": 0.5,
    "same_class_overlap": "support_or_probability_max",
    "cross_class_overlap": "pixel_probability_argmax",
    "numerical_tie_value": 255,
    "tie_epsilon": 1e-06,
    "inside_box_unconfirmed_value": 255,
    "outside_box_value": 0,
    "empty_3d_slice_value": 0,
    "additional_margin_threshold": null
  },
  "student": {
    "protocol": "student_v2_mim_protocol",
    "loss": "dice_plus_cross_entropy",
    "ignore_label": 255,
    "crop_policy_tg3k": "full_image",
    "deep_supervision_num_outputs": 3,
    "deep_supervision_weights": [
      0.5714285714285714,
      0.2857142857142857,
      0.14285714285714285
    ],
    "freeze_complete_encoder_epochs": 10,
    "checkpoint_policy": "last_epoch",
    "use_validation_for_checkpoint_selection": false,
    "mim_adaptation": true
  },
  "active_learning": {
    "protocol": "active_learning_v2",
    "round0_selection": "random",
    "per_round_ratio": 0.01,
    "minimum_per_round": 5,
    "per_round_rounding": "ceil",
    "cumulative_full_ratio": 0.05,
    "cumulative_full_rounding": "ceil",
    "two_d": {
      "annotation_unit": "image",
      "per_round_formula": "max(ceil(0.01*N_train_images),5)",
      "cumulative_budget_formula": "max(1,ceil(0.05*N_train_images))",
      "difficulty_metric": "image_min_iou"
    },
    "three_d": {
      "annotation_unit": "case",
      "per_round_formula": "max(ceil(0.01*N_train_cases),5)",
      "cumulative_budget_formula": "max(1,ceil(0.05*N_train_cases))",
      "difficulty_metric": "case_min_slice_class_iou"
    },
    "iou_threshold": 0.5,
    "convergence_rule": "all_remaining_pseudo_gt_iou_ge_0.5",
    "decision_status": [
      "CONTINUE",
      "CONVERGED",
      "BUDGET_EXHAUSTED"
    ]
  }
}
